{
  "name": "peta-hono",
  "version": "0.6.4",
  "description": "Function-based API DSL on Hono + ArkType — declare endpoints, get typed validation, auth, and auto-generated OpenAPI docs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zfadhli/peta-hono.git"
  },
  "homepage": "https://github.com/zfadhli/peta-hono#readme",
  "bugs": {
    "url": "https://github.com/zfadhli/peta-hono/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./password": {
      "types": "./dist/password.d.ts",
      "import": "./dist/password.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:dist": "nub run build && STALE=$(git status --porcelain -- dist/) && if [ -n \"$STALE\" ]; then echo 'dist/ is stale — run `nub run build` and commit dist/:' \"$STALE\"; exit 1; fi",
    "prepublishOnly": "nub run check:dist",
    "dev": "nub examples/basic/index.ts",
    "check": "vitest run examples/basic/app.test.ts",
    "blog": "nub examples/blog/index.ts",
    "blog:check": "vitest run examples/blog/app.test.ts",
    "check:auth": "vitest run src/auth.test.ts",
    "strategies": "nub examples/strategies/index.ts",
    "strategies:check": "vitest run examples/strategies/app.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ examples/",
    "lint:fix": "biome check --write --unsafe src/ examples/",
    "format": "biome format src/ examples/",
    "format:fix": "biome format --write src/ examples/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:all": "vitest run"
  },
  "peerDependencies": {
    "arktype": "^2.2.1",
    "hono": "^4.7.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@scalar/hono-api-reference": "^0.5.0",
    "jose": "^6.2.10"
  },
  "allowBuilds": {
    "@evilmartians/lefthook": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@evilmartians/lefthook": "^2.1.9",
    "@hono/node-server": "^1.13.0",
    "@libsql/client": "^0.14.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-orm": "^0.38.0",
    "peta-auth": "0.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "hono",
    "arktype",
    "openapi",
    "api",
    "dsl",
    "rest",
    "validation",
    "typescript"
  ]
}
